# OIDC Configuration
VITE_OIDC_AUTHORITY=https://virtualgarage-identityserver.azurewebsites.net
VITE_OIDC_CLIENT_ID=react-app-client
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
VITE_OIDC_CLIENT_SECRET=reactapp-secret
VITE_OIDC_SCOPE=openid profile roles virtualgarage.api.read virtualgarage.api.write
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login

# API Configuration
VITE_API_BASE_URL=https://virtualgarage-api.azurewebsites.net/api
